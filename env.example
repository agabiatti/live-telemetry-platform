# Copie para .env (ou exporte) antes do `make demo`. Defaults servem para o demo local.

# --- Broker / Schema Registry (nomes de serviço do compose) ---
KAFKA_BOOTSTRAP=redpanda:29092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# --- Tópicos ---
TOPIC_PLAYER_EVENTS=player_events
TOPIC_SCTE35=scte35_markers
TOPIC_CONTENT=content_metadata
TOPIC_AD_DECISIONS=ad_decisions

# --- Producer / replay ---
# 1 = fiel (105min), 60 = demo (~2min), 100000 = bulk
REPLAY_SPEED=60

# --- Caminhos do lake (dentro do container) ---
DATA_DIR=/app/data
BRONZE_PATH=/app/data/bronze
SILVER_PATH=/app/data/silver
GOLD_PATH=/app/data/gold

# --- Silver: event-time / watermark (segundos) ---
WATERMARK_DELAY_S=25
ALLOWED_LATENESS_S=60
# Espera system-time do EventClock antes de fechar janela (interage com REPLAY_SPEED)
SILVER_SYSTEM_WAIT_S=10
SESSION_IDLE_TIMEOUT_S=120
DEDUPE_HORIZON_S=180
WINDOW_SIZE_S=60

# --- Observabilidade ---
SLO_CONFIG=/app/OBSERVABILITY/slos.yaml
LOG_LEVEL=INFO
